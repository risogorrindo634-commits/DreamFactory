  {
    "id": "chart-points-misplaced",
    "title": "折线图上的点画在了别的月份的高度上",
    "base": "monthly-trend",
    "ops": [
      {
        "file": "scenes",
        "replace": "cy: y(it.value), r:",
        "with": "cy: y(items[(i * 5) % items.length].value), r:"
      }
    ],
    "expectFail": [
      "marks"
    ]
  },
  {
    "id": "chart-axis-inverted",
    "title": "折线图的纵轴画反了，数值越大位置越低",
    "base": "monthly-trend",
    "ops": [
      {
        "file": "scenes",
        "replace": "const y = (v) => box.bottom - (v / top) * (box.bottom - box.top);",
        "with": "const y = (v) => box.top + (v / top) * (box.bottom - box.top);"
      }
    ],
    "expectFail": [
      "marks"
    ]
  },
  {
    "id": "chart-without-values",
    "title": "自定义图表没有标出每个点代表的数值",
    "base": "monthly-trend",
    "ops": [
      {
        "file": "scenes",
        "replace": "'data-df-value': it.value, ",
        "with": ""
      }
    ],
    "expectFail": [
      "marks"
    ]
  },
  {
    "id": "chart-uses-random",
    "title": "自定义场景里用了随机数，每次重画都不一样",
    "base": "monthly-trend",
    "ops": [
      {
        "file": "scenes",
        "replace": "p.dot.style.opacity = String(shown);",
        "with": "p.dot.style.opacity = String(shown);\n        p.dot.setAttribute('r', String(8 + Math.random() * 14));"
      }
    ],
    "expectFail": [
      "determinism"
    ]
  },
  {
    "id": "chart-points-invisible",
    "title": "折线图上的点半径写成零，画不出来",
    "base": "monthly-trend",
    "ops": [
      {
        "file": "scenes",
        "replace": "r: hot ? 12 : 8,",
        "with": "r: 0,"
      }
    ],
    "expectFail": [
      "marks"
    ]
  },
  {
    "id": "ranges-scale-not-a-range",
    "title": "区间图的 scale 写成了 \"log\"，四根条形画不出来",
    "base": "cost-per-minute",
    "ops": [
      {
        "file": "film",
        "set": "scenes[1].scale",
        "value": "log"
      }
    ],
    "expectError": "scale must be [low, high]"
  },
  {
    "id": "chart-lags-narration",
    "title": "折线图画得太晚，旁白念完数字画面才出现",
    "base": "monthly-trend",
    "ops": [
      {
        "file": "scenes",
        "replace": "ease((t - 0.5) / 1.8)",
        "with": "ease((t - 9) / 1.8)"
      }
    ],
    "expectFail": [
      "sync"
    ]
  },
