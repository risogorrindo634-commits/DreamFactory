{
  "vertical": "data-story",
  "lang": "zh",
  "title": "一年里每个月新增多少作品",
  "source": "数据来源：{{source.name}}（截至 {{source.asOf}}）",
  "theme": { "accent": "#62c6ff" },
  "voice": { "backend": "auto", "name": "stella" },
  "scenes": [
    {
      "id": "open",
      "type": "title",
      "kicker": "数据短片",
      "headline": "一年里每个月新增多少作品",
      "sub": "某视频社区 {{facts.year}} 年",
      "narration": [
        "这是某视频社区{{facts.year}}年的数据。",
        "我们看每个月新增的代码生成作品。"
      ]
    },
    {
      "id": "trend",
      "type": "line",
      "title": "每月新增作品数",
      "sub": "{{facts.year}} 年，按月统计",
      "series": { "$": "series.monthly" },
      "narration": [
        "全年每个月新增的数量，连成一条线。",
        "1月新增{{series.monthly[1月]}}件，是全年的起点。",
        "9月是{{series.monthly[9月]}}件，和8月差不多。",
        "10月一下子跳到{{series.monthly[10月]}}件。",
        "全年最高的是11月。",
        "这个月新增{{series.monthly[11月]}}件。"
      ]
    },
    {
      "id": "close",
      "type": "outro",
      "headline": "下半年，增长明显加快",
      "sub": "示例数据，虚构，仅用于演示",
      "narration": [
        "11月是1月的{{times series.monthly[1月] series.monthly[11月]}}倍。",
        "下半年的加速很明显。"
      ]
    }
  ]
}
