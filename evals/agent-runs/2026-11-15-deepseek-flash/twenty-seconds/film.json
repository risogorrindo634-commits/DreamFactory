{
  "vertical": "data-story",
  "lang": "zh",
  "title": "二十秒看懂类型分布",
  "source": "数据来源：{{source.name}}（截至 {{source.asOf}}）",
  "theme": { "accent": "#62c6ff" },
  "voice": { "backend": "auto" },
  "scenes": [
    {
      "id": "total",
      "type": "title",
      "kicker": "数据短片",
      "headline": "{{facts.total}} 件作品",
      "sub": "按类型看它们怎么分布",
      "narration": ["{{facts.total}} 件作品，按类型看分布。"]
    },
    {
      "id": "top-type",
      "type": "bignumber",
      "label": "模型对比",
      "value": "{{series.categories[模型对比]}}",
      "unit": "件",
      "note": "数量最多的类型",
      "narration": ["最多的是模型对比，{{series.categories[模型对比]}} 件。"]
    },
    {
      "id": "all-types",
      "type": "bars",
      "title": "各类型作品数量",
      "sub": "按数量从多到少排列",
      "series": { "$": "series.categories" },
      "highlight": "游戏",
      "unit": "件",
      "minDuration": 5,
      "narration": ["游戏类有 {{series.categories[游戏]}} 件。"]
    },
    {
      "id": "close",
      "type": "outro",
      "headline": "类型不同，分量不同。",
      "narration": ["不同类型，各有各的分量。"]
    }
  ]
}
